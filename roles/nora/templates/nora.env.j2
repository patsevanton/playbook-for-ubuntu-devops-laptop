# {{ nora_env_file }}
# Файл управляется Ansible (роль nora) — ручные правки будут перезаписаны.
# Меняйте переменные в roles/nora/defaults/main.yml (или group_vars).
#
# Это EnvironmentFile для systemd-юнита nora.service (пакет читает его через
# EnvironmentFile=-/etc/nora/nora.env). Окружение имеет приоритет над
# config.toml. Юнит работает как User=nora с WorkingDirectory=/etc/nora,
# поэтому хранилище — только по абсолютным путям в /var/lib/nora.
#
# Авторизация локально не нужна (pull-proxy public Docker Hub + terraform),
# поэтому NORA_AUTH_ENABLED не задаём — падает на дефолт false.

# --- Сервер ---------------------------------------------------------------
NORA_HOST={{ nora_bind_host }}
NORA_PORT={{ nora_port }}
# Публичный URL для ссылок на скачивание в UI (Terraform-провайдеры и пр.).
NORA_PUBLIC_URL={{ nora_public_url }}

# --- Хранилище (абсолютные пути — WorkingDirectory юнита = /etc/nora) -----
NORA_STORAGE_PATH={{ nora_data_dir }}

# --- Terraform-провайдеры (caching proxy) ---------------------------------
# Включает proxy-only реестр Terraform: бинарники провайдеров кэшируются,
# публикация не поддерживается. Клиент: network_mirror в ~/.terraformrc.
NORA_TF_ENABLED={{ nora_tf_enabled | lower }}
NORA_TF_PROXY={{ nora_tf_proxy }}

# --- Docker pull-through cache (Docker Hub) --------------------------------
# NORA выступит кэшем для upstream-реестров. По умолчанию — Docker Hub.
NORA_DOCKER_PROXIES={{ nora_docker_proxies }}