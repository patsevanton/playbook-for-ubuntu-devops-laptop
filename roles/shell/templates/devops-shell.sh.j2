# {{ shell_file }}
# Окружение DevOps-ноутбука.
# Файл управляется Ansible (роль shell) — ручные правки будут перезаписаны.
# Подключён из ~/.bashrc одной строкой source.

# --- PATH ------------------------------------------------------------------
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH="$HOME/.tfenv/bin:$HOME/.tgenv/bin:$PATH"

# --- krew: kubectl-плагины (~/.krew/bin) ------------------------------------
if [ -d "$HOME/.krew/bin" ]; then
  export PATH="$HOME/.krew/bin:$PATH"
fi

# --- fzf: поиск + keybindings/completion -----------------------------------
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi

# --- direnv: окружение по каталогам ----------------------------------------
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi

# --- zoxide: умный cd ------------------------------------------------------
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# --- starship: prompt ------------------------------------------------------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# --- eza вместо ls ---------------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l  --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2 --group-directories-first'
fi

# --- bat (бинарь /usr/local/bin/bat) ---------------------------------------
if command -v bat >/dev/null 2>&1; then
  alias catbat='bat --paging=never'
  export BAT_THEME="${BAT_THEME:-ansi}"
fi

# --- fd-find в Ubuntu называется fdfind ------------------------------------
if command -v fdfind >/dev/null 2>&1; then
  alias fd='fdfind'
fi

# --- kubectl / helm / kubectx: completion и алиасы -------------------------
if command -v kubectl >/dev/null 2>&1; then
  alias k='kubectl'
  source <(kubectl completion bash)
fi
if command -v helm >/dev/null 2>&1; then
  source <(helm completion bash)
fi
if command -v flux >/dev/null 2>&1; then
  source <(flux completion bash)
fi
if [ -f /etc/bash_completion.d/kubectx ]; then
  . /etc/bash_completion.d/kubectx
fi

# --- Python-утилиты --------------------------------------------------------
export PIPX_HOME="${PIPX_HOME:-$HOME/.local/pipx}"
export PIPX_BIN_DIR="${PIPX_BIN_DIR:-$HOME/.local/bin}"

# --- atuin: НЕ используем ---------------------------------------------------
# История команд (atuin) сознательно исключена. atuin подключает bash-preexec,
# который на bash >= 5.3 вешает preexec-хук в PS0 строкой '${ ... }'.
# Интеграция VTE (/etc/profile.d/vte-2.91.sh, gnome-terminal) заканчивает свой
# PS0 последовательностью \e\\ (OSC-терминатор ST), чей завершающий '\'
# экранирует '$' хука — и строка '${ __bp_invoke_preexec_from_ps0 "..." >&2; }'
# печатается буквально перед каждой командой. Баг на стороне VTE, исправлен
# только в vte 0.84:
#   GNOME/vte#2951    https://gitlab.gnome.org/GNOME/vte/-/work_items/2951
#   bash-preexec#186  https://github.com/rcaloras/bash-preexec/issues/186
# Вернуть atuin можно после выхода vte 0.84 (или накатив патч из VTE#2951).
